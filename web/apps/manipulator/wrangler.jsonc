{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "ears-manipulator",
	"compatibility_date": "2026-08-13",

	// No `main`: there is no server-side code at all. Decoding the skin, rendering the preview and
	// encoding the export all happen in the browser, and no skin is ever uploaded anywhere.
	"assets": {
		"directory": "./dist",
		// unmatched paths serve index.html rather than a 404, for client-side routes later on
		"not_found_handling": "single-page-application"
	},

	"routes": [
		{
			"pattern": "skin.daisy.cat",
			"custom_domain": true
		}
	],

	"observability": {
		"enabled": true
	}
}
