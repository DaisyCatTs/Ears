{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": [
			"node"
		]
	},
	"include": [
		"packages/*/src/**/*.ts",
		"packages/*/test/**/*.ts",
		"packages/*/scripts/**/*.ts",
		"apps/*/src/**/*.ts",
		"apps/*/src/**/*.tsx",
		"apps/*/*.ts",
		"apps/*/worker/**/*.ts",
		"apps/*/worker-configuration.d.ts"
	]
}
